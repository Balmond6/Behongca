{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "strict": false,
    "noEmit": true
  },
  "include": [
    "api/**/*.ts",
    "lib/**/*.ts",
    "scripts/**/*.ts",
    "server.ts"
  ]
}
